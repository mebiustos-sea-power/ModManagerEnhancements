<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="ModManagerEnhancementsSearch" Margin="30,8,30,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="120"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <TextBlock x:Name="SearchLabel" VerticalAlignment="Center" Foreground="{StaticResource Brush.Glyph.Normal}"/>
  <Grid Grid.Column="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Brush.Button.Background}" BorderBrush="{StaticResource Brush.Glyph.Normal}" BorderThickness="1">
      <Grid>
        <TextBox x:Name="SearchText" Padding="4,3" Background="{StaticResource Brush.Button.Background}"/>
        <TextBlock x:Name="SearchPlaceholder" Margin="4,3" Opacity="0.55" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
    <Button x:Name="ClearSearch" Grid.Column="1" Content="×" Padding="10,2" Margin="6,0,0,0" Visibility="Collapsed"/>
  </Grid>
  <ComboBox x:Name="ContentKind" Grid.Column="4" MinWidth="120"/>
  <TextBlock x:Name="VisibleCount" Grid.Column="6" VerticalAlignment="Center" Foreground="{StaticResource Brush.Glyph.Normal}"/>
  <TextBlock x:Name="NoMatchingMods" Grid.Row="1" Grid.ColumnSpan="7" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{StaticResource Brush.Glyph.Normal}"/>
</Grid>
